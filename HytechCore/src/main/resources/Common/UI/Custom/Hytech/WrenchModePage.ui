// Picks the resource the wrench configures. Crouch and right-click with the wrench to open.
//
// One button per possible resource, hidden when unused, so the page never has to build elements at
// runtime. The resource currently selected is disabled rather than marked with a prefix: the
// vanilla disabled style already reads as "you are here", and a control that would do nothing
// should not accept the click.
$C = "../Common.ui";
$H = "Hytech.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    @CloseButton = true;
    Anchor: (Width: 360, Height: 420);

    #Title {
      Label #TitleLabel {
        Style: $H.@TitleLabelStyle;
        Text: "Wrench Mode";
      }
    }

    #Content {
      LayoutMode: Top;

      Label #Hint {
        Anchor: (Width: 300, Bottom: 14);
        Style: $H.@CaptionStyle;
        Text: "Pick the resource the wrench configures.";
      }

      $C.@SecondaryTextButton #Mode0 { @Anchor = (Width: 300, Bottom: 6); @Text = ""; }
      $C.@SecondaryTextButton #Mode1 { @Anchor = (Width: 300, Bottom: 6); @Text = ""; }
      $C.@SecondaryTextButton #Mode2 { @Anchor = (Width: 300, Bottom: 6); @Text = ""; }
      $C.@SecondaryTextButton #Mode3 { @Anchor = (Width: 300, Bottom: 6); @Text = ""; }
      $C.@SecondaryTextButton #Mode4 { @Anchor = (Width: 300, Bottom: 6); @Text = ""; }
      $C.@SecondaryTextButton #Mode5 { @Anchor = (Width: 300, Bottom: 6); @Text = ""; }

      Group { FlexWeight: 1; }

      Group {
        Background: $H.@ColorPanelBorder;
        Anchor: (Height: 1, Bottom: 10);
      }

      Label {
        Anchor: (Height: 16);
        Style: $H.@CaptionStyle;
        Text: "Right-click a block face to cycle it.";
      }
    }
  }
}
